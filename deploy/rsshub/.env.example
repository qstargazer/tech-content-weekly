# Copy this file to .env on the QNAP and fill the value locally.
# Never commit .env or paste the cookie into chat.
# Use a full Bilibili browser Cookie header, not only SESSDATA.
BILIBILI_COOKIE_data1=

# RSSHub /newrank/wechat/:wxid uses this cookie to retrieve article content.
# Obtain the token part from a logged-in newrank.cn browser session.
NEWRANK_COOKIE=
