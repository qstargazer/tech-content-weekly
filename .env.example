# YouTube 官方 Data API。未配置时 YouTube 在线采集会跳过。
YOUTUBE_API_KEY=

# Gmail SMTP。仅使用 --send 时需要。
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 可选：覆盖 config.toml 收件人，多个邮箱用英文逗号分隔
EMAIL_RECIPIENTS=

# AI 洞察：优先 OpenAI，失败后自动回退 DeepSeek。
OPENAI_API_KEY=
# 可选，不填则使用 config.toml 默认值
OPENAI_MODEL=
DEEPSEEK_API_KEY=
# 可选，不填则使用 config.toml 默认值
DEEPSEEK_MODEL=
